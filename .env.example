# NeuroVision AI - Environment Variables

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Deep Learning Inference Devices ('cuda' or 'cpu')
DEVICE=cpu

# Model Weights Paths
NNUNET_WEIGHTS_PATH=models/best_nnunet_model.pt
CLASSIFIER_WEIGHTS_PATH=models/best_model.pt

# Monte Carlo Dropout Parameters
DEFAULT_MC_PASSES=6
UNCERTAINTY_THRESHOLD=35.0

# Security & Limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.nii,.nii.gz
